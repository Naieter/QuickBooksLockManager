<Window x:Class="QBLockManager.Views.AuditLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit Log" Height="500" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Recent Lock Activity" FontWeight="SemiBold"
                   FontSize="14" Margin="0,0,0,8"/>
        <DataGrid x:Name="Grid" IsReadOnly="True" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimestampUtc, StringFormat=g}" Width="140"/>
                <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="160"/>
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="180"/>
                <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="120"/>
                <DataGridTextColumn Header="Machine" Binding="{Binding MachineName}" Width="120"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
