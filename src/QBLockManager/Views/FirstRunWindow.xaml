<Window x:Class="QBLockManager.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickBooks Lock Manager — Get Started"
        Width="600" Height="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Content -->
            <RowDefinition Height="Auto"/>  <!-- Nav buttons -->
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0" Background="#2A2A3E" Padding="32,20,32,16">
            <StackPanel>
                <TextBlock Text="Almost there" FontSize="22" FontWeight="Bold" Foreground="#E2E8F0"/>
                <TextBlock Text="Just two things, then you're set up." FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── Content ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,20,40,8">

                <!-- Connection -->
                <TextBlock Text="① Connection to the Lock Server" FontSize="14" FontWeight="SemiBold"
                           Foreground="#E2E8F0" Margin="0,0,0,8"/>

                <Border x:Name="BannerProfileLoaded" Visibility="Collapsed"
                        Background="#1E3A2E" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                    <TextBlock TextWrapping="Wrap" Foreground="#86EFAC" FontSize="13">
                        ✓ Connection settings were found automatically. You're good to go.
                    </TextBlock>
                </Border>

                <Border x:Name="DropZone" Visibility="Collapsed"
                        Background="#2A2A3E" BorderBrush="#3F3F5C" BorderThickness="1"
                        CornerRadius="6" Padding="16,20" Margin="0,0,0,12"
                        AllowDrop="True" Cursor="Hand"
                        DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                        Drop="DropZone_Drop" MouseLeftButtonUp="DropZone_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📄" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Drag your connection file here, or click to browse"
                                   Foreground="#94A3B8" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="(qblm-connect.json — from your administrator)"
                                   Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TxtManualToggle" Text="Enter server address manually instead"
                           Foreground="#6366F1" FontSize="12" Margin="0,0,0,12" Cursor="Hand"
                           MouseLeftButtonUp="ManualToggle_Click" TextDecorations="Underline"/>

                <StackPanel x:Name="PanelManual" Visibility="Collapsed" Margin="0,0,0,12">
                    <TextBlock Text="Lock Server Address" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtServerUrl" FontSize="13" Padding="10,8"
                             Background="#2A2A3E" Foreground="#E2E8F0"
                             BorderBrush="#3F3F5C" BorderThickness="1" Margin="0,0,0,10"/>
                    <TextBlock Text="Access Key" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtApiKey" FontSize="13" Padding="10,8"
                             Background="#2A2A3E" Foreground="#E2E8F0"
                             BorderBrush="#3F3F5C" BorderThickness="1"/>
                </StackPanel>

                <Separator Background="#3F3F5C" Margin="0,12,0,20"/>

                <!-- QB folder -->
                <TextBlock Text="② Where are your QuickBooks files?" FontSize="14" FontWeight="SemiBold"
                           Foreground="#E2E8F0" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtQBFolder" Grid.Column="0" FontSize="13" Padding="10,8"
                             Background="#2A2A3E" Foreground="#E2E8F0"
                             BorderBrush="#3F3F5C" BorderThickness="1" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="Browse…" Click="BrowseFolder_Click"
                            Margin="8,0,0,0" Padding="14,8" FontSize="13" Cursor="Hand"
                            Background="#374151" Foreground="White" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#4B5563"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <TextBlock x:Name="TxtQBDetectStatus" TextWrapping="Wrap"
                           Foreground="#94A3B8" FontSize="12" Margin="0,20,0,0"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Nav buttons ── -->
        <Border Grid.Row="2" Background="#2A2A3E" BorderBrush="#3F3F5C" BorderThickness="0,1,0,0" Padding="32,12">
            <Button x:Name="BtnFinish" Content="Get Started" Click="Finish_Click"
                    HorizontalAlignment="Right"
                    Padding="24,9" FontSize="13" Cursor="Hand"
                    Background="#22C55E" Foreground="White" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#16A34A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
    </Grid>
</Window>
