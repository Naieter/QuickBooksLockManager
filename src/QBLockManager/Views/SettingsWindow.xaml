<Window x:Class="QBLockManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="540" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}"
        ResizeMode="NoResize">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0,0,8,0"/>
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
        </StackPanel>

        <ScrollViewer>
            <StackPanel>

                <TextBlock Text="Lock Service" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                <Label Content="Lock Service URL"/>
                <TextBox x:Name="ServiceUrl" Margin="0,0,0,12"/>

                <Label Content="API Key (leave blank to disable auth in dev)"/>
                <TextBox x:Name="ApiKey" Margin="0,0,0,12"/>

                <Separator Background="{StaticResource Border}" Margin="0,0,0,16"/>

                <TextBlock Text="QuickBooks" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                <Label Content="QuickBooks Executable Path"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="QBPath" Grid.Column="0"/>
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButton}"
                            Margin="4,0,0,0" Click="BrowseQB_Click"/>
                </Grid>

                <CheckBox x:Name="MultiFile" Content="Enable Multi-File Mode (allows multiple company files open at once)"
                          Foreground="{StaticResource Text}" Margin="0,0,0,12"/>

                <Label Content="QuickBooks File Password (auto-filled on login dialog — leave blank to disable)"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="QBPassword" Grid.Column="0"
                                 PasswordChar="●"
                                 VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="ShowQBPassword" Grid.Column="1"
                              Content="Show" Foreground="{StaticResource SubText}"
                              Margin="8,0,0,0" VerticalAlignment="Center"
                              Checked="ShowQBPassword_Changed" Unchecked="ShowQBPassword_Changed"/>
                </Grid>
                <TextBox x:Name="QBPasswordVisible" Margin="0,0,0,16" Visibility="Collapsed"/>


                <Separator Background="{StaticResource Border}" Margin="0,0,0,16"/>

                <TextBlock Text="User Identity" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                <Label Content="Username (used in lock records)"/>
                <TextBox x:Name="UserName" Margin="0,0,0,8"/>
                <Label Content="Display Name (optional)"/>
                <TextBox x:Name="DisplayName" Margin="0,0,0,8"/>
                <Label Content="Email (optional)"/>
                <TextBox x:Name="Email" Margin="0,0,0,16"/>

                <Separator Background="{StaticResource Border}" Margin="0,0,0,16"/>

                <TextBlock Text="Watched Folders" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                <TextBlock Text="Add one folder per line (path only):" Foreground="{StaticResource SubText}" FontSize="12"/>
                <TextBox x:Name="WatchedFolders" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                         Margin="0,4,0,8" VerticalScrollBarVisibility="Auto"/>
                <CheckBox x:Name="Recursive" Content="Search subfolders recursively"
                          Foreground="{StaticResource Text}" Margin="0,0,0,8"/>

                <Label Content="Shared Root Path (for stable file key — the base path common across all workstations)"/>
                <TextBox x:Name="SharedRoot" Margin="0,0,0,12"/>

                <Separator Background="{StaticResource Border}" Margin="0,0,0,16"/>

                <TextBlock Text="Heartbeat" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                <Label Content="Heartbeat Interval (seconds, 10–60)"/>
                <TextBox x:Name="HeartbeatInterval" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
