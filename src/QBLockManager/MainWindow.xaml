<Window x:Class="QBLockManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QBLockManager.ViewModels"
        xmlns:conv="clr-namespace:QBLockManager.Converters"
        Title="{Binding AppVersion, StringFormat='QuickBooks Lock Manager {0}'}"
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Background}"
        Closing="Window_Closing">

    <Window.Resources>
        <conv:AvailabilityToColorConverter x:Key="AvailColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="QuickBooks Lock Manager" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersion}" FontSize="11"
                               Foreground="{StaticResource SubText}" VerticalAlignment="Center"
                               Margin="6,2,0,0"/>
                    <Border Background="{Binding ServiceReachable, Converter={StaticResource AvailColor}}"
                            CornerRadius="10" Padding="8,2" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ServiceStatus}" FontSize="11" Foreground="White"/>
                    </Border>
                </StackPanel>

                <TextBox Grid.Column="1" Width="200" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Resources>
                                <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                    <VisualBrush.Visual>
                                        <Label Content="Search files..." Foreground="{StaticResource SubText}"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource CueBannerBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Button Grid.Column="2" Content="⟳ Refresh" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" Margin="0,0,8,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvBoolVis}}"/>

                <Button Grid.Column="3" Content="⚙ Settings" Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenSettingsCommand}"/>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                Padding="12,4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SubText}" FontSize="12"/>
        </Border>

        <!-- Main content -->
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <!-- File list -->
            <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" Padding="8,6"
                            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Company Files" FontWeight="SemiBold" FontSize="13"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Files.Count, StringFormat=' ({0})'}"
                                       Foreground="{StaticResource SubText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="FilesGrid"
                              ItemsSource="{Binding Files}"
                              SelectedItem="{Binding SelectedFile}"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="6,2" Margin="2,2"
                                                Background="{Binding Availability, Converter={StaticResource AvailColor}}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                       Foreground="White" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="200"/>
                            <DataGridTextColumn Header="User" Binding="{Binding UserText}" Width="130"/>
                            <DataGridTextColumn Header="Computer" Binding="{Binding ComputerText}" Width="130"/>
                            <DataGridTextColumn Header="Locked Since" Binding="{Binding LockedSinceText}" Width="130"/>
                            <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenText}" Width="130"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding LocalPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Action buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8" HorizontalAlignment="Left">
                <Button Content="▶ Open" Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenFileCommand}" Margin="0,0,8,0"
                        IsEnabled="{Binding ServiceReachable}"/>

                <Button Content="⇄ Switch File" Style="{StaticResource SecondaryButton}"
                        Command="{Binding SwitchFileCommand}" Margin="0,0,8,0"
                        IsEnabled="{Binding ServiceReachable}"/>

                <Button Content="+ Open Another" Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenAnotherCommand}" Margin="0,0,8,0"
                        IsEnabled="{Binding MultiFileMode}"
                        Visibility="{Binding MultiFileMode, Converter={StaticResource BoolVis}}"/>

                <Button Content="📋 Audit Log" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ShowAuditLogCommand}" Margin="0,0,8,0"/>

                <Button Content="⚡ Force Unlock" Style="{StaticResource DangerButton}"
                        Command="{Binding AdminForceUnlockCommand}"/>
            </StackPanel>

            <!-- My Active Locks -->
            <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" Padding="8,6"
                            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="My Active Locks" FontWeight="SemiBold" FontSize="13"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MyActiveLocks.Count, StringFormat=' ({0})'}"
                                           Foreground="{StaticResource SubText}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Content="Release Selected Lock"
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding ReleaseSelectedLockCommand}"
                                    IsEnabled="{Binding SelectedActiveLock, Converter={StaticResource BoolVis}, ConverterParameter=notnull}"/>
                        </Grid>
                    </Border>

                    <DataGrid ItemsSource="{Binding MyActiveLocks}"
                              SelectedItem="{Binding SelectedActiveLock}"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="200"/>
                            <DataGridTextColumn Header="Acquired" Binding="{Binding AcquiredAtText}" Width="140"/>
                            <DataGridTextColumn Header="Last Heartbeat" Binding="{Binding LastHeartbeatText}" Width="140"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding LocalPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
